<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="bei_verifica_descarga_form_view" model="ir.ui.view">
            <field name="name">bei.verifica.descarga.view.form</field>
            <field name="model">bei.verifica.descarga</field>
            <field name="arch" type="xml">
                <form string="Verifica Solicitud de Descarga">
                    <header>
                        <field name="state" widget="statusbar" statusbar_visible="draft,en_proceso,done"/>
                        <button name="action_desactivar" string="Desactivar" type="object" groups="base.group_system"/>
                        <button name="download_cfdi_invoices_btw_two_dates" string="Verifica Ahora" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <h2>
                                <field name="name" readonly="1"/>
                            </h2>
                        </div>
                        <group>
                            <group>
                                <field name="descripcion"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <field name="tipo_cfdi" readonly="1"/>
                                <field name="origin" readonly="1" groups="base.group_system"/>
                                 <field name="idsolicitud" readonly="1" groups="base.group_system"/>
                                <field name="descarga_realizada" readonly="1"/>
                            </group>
                            <group>
                                <field name="date_order" readonly="1"/>
                                <field name="company_id" readonly="1"/>
                                <field name="user_id" readonly="1" groups="base.group_system"/>
                                <field name="last_cfdi_fetch_date" readonly="1"/>
                                <field name="estado_solicitud" readonly="1"/>
                                <field name="respuesta_api" readonly="1" groups="base.group_system"/>
                                <field name="cod_estado_solicitud" groups="base.group_system"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="bei_verifica_descarga_tree_view" model="ir.ui.view">
            <field name="name">bei.verifica.descarga.tree</field>
            <field name="model">bei.verifica.descarga</field>
            <field name="arch" type="xml">
                <tree string="Verificación de Descargas">
                        <field name="date_order"/>
                        <field name="name"/>
                        <field name="descripcion"/>
                        <field name="tipo_cfdi"/>
                        <field name="last_cfdi_fetch_date"/>
                        <field name="estado_solicitud" />
                        <field name="state"
                               decoration-success="state == 'done'"
                               decoration-info="state == 'en_proceso'"
                               widget="badge" optional="show"/>

                </tree>
            </field>
        </record>


        <record id="bei_verifica_descarga_action" model="ir.actions.act_window">
            <field name="name">Verifica Solicitud de Descargas</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">bei.verifica.descarga</field>
            <field name="domain">[('company_id','in',allowed_company_ids)]</field>
            <field name="view_mode">tree,form</field>
        </record>
        <!-- Secuencia-->
        <record id="bei_verifica_descarga_seq" model="ir.sequence">
            <field name="name">Solicitud de Descarga</field>
            <field name="code">bei.verifica.descarga</field>
            <field name="implementation">standard</field>
            <field name="company_id"></field>
            <field name="active">TRUE</field>
            <field name="prefix">SOL%(year)s%(month)s</field>
            <field name="padding">5</field>
            <field name="number_increment">1</field>
            <field name="use_date_range">False</field>
        </record>
    </data>
</odoo>