<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_import_cfdi_invoice_from_ir_attachment_form" model="ir.ui.view">
            <field name="name">Import Invoice from Attachment</field>
            <field name="model">cfdi.invoice.attachment</field>
            <field name="arch" type="xml">
                <form string="Importar facturas de proveedor">
                	<group>
                		<field name="supplier_journal_id" context="{'default_type': 'purchase'}" required="1"  domain="[('company_id','=',company_id),('type','=','purchase')]"/>
<!--                        <field name="buscar_producto_por_clave_sat" />-->
                        <field name="si_producto_no_tiene_codigo" />
<!--                        attrs="{'invisible': [('buscar_producto_por_clave_sat', '==', True)]}"-->
                		<field name="product_id" invisible="si_producto_no_tiene_codigo != 'Buscar manual'" required="si_producto_no_tiene_codigo == 'Buscar manual'"/>

                		<field name="company_id" readonly="1"/>
                	</group>
                	<footer>
                        <button name="import_xml_file" string="Importar" type="object" class="oe_highlight"/> 
                        <button string="Cancelar" class="oe_highlight" special="cancel" />
                    </footer>
               </form>
            </field>
        </record>
    </data>
</odoo>
