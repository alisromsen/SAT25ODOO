<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_import_cfdi_invoice_xml_attachment_form" model="ir.ui.view">
            <field name="name">descarga.x.dia.wizard.form</field>
            <field name="model">descarga.x.dia.wizard</field>
            <field name="arch" type="xml">
                <form>
                	<group>
	                	<group>
	                		<field name="start_date" required="1" />
	                	</group>
	                	<group>
	                		<field name="end_date" required="1" />
	                	</group>
						<field name="descripcion"/>
                	</group>
                	
                	<footer>
                        <button name="create_request_download_xml" string="Generar" type="object" class="oe_highlight"/>
                        <button string="Cancelar" class="oe_highlight" special="cancel" />
                    </footer>
               </form>
            </field>
        </record>

        <record id="action_solicitud_descarga_xml_wz" model="ir.actions.act_window">
		<field name="name">Descarga Por Rango Fecha XML</field>
		<field name="res_model">descarga.x.dia.wizard</field>
		<field name="type">ir.actions.act_window</field>
		<field name="view_mode">form</field>
		<field name="view_id" ref="view_import_cfdi_invoice_xml_attachment_form"/>
		<field name="target">new</field>
		<field name="domain"></field>
	</record>

    </data>
</odoo>